  },
  "epochs": 5,
  "eval_every": 1,
  "learning_rate": 0.001,
  "seed": 13,
  "channels": 32,
  "max_points_per_pillar": 64,
  "cpu_threads": 2,
  "device": "cuda",
  "minimum_free_memory_mib": 2048,
  "score_threshold": 0.3,
  "top_k": 50,
  "match_radius_m": 1.0,
  "max_grad_norm": 10.0,
  "log_every_steps": 50
}
