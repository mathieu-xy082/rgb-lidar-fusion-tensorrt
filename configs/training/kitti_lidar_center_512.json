{
  "data_root": "data/kitti/training",
  "output_dir": "results/training/kitti_lidar_center_512",
  "sample_count": 512,
  "validation_fraction": 0.2,
  "split_seed": 13,
  "grid": {
    "x_range_m": [0.0, 50.0],
    "y_range_m": [-25.0, 25.0],
